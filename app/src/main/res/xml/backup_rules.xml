<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive encrypted vault files, trash, preferences, and database from backups -->
    <exclude domain="file" path="vault" />
    <exclude domain="file" path="trash" />
    <exclude domain="file" path="datastore" />
    <exclude domain="database" path="liquid_files.db" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
